{
  "name": "vtrack",
  "private": true,
  "version": "0.1.0",
  "description": "vTrack enterprise monorepo — mobile, web cockpit, Supabase",
  "workspaces": [
    "apps/web-cockpit",
    "apps/mobile"
  ],
  "scripts": {
